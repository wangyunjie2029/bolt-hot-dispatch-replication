+//===- bolt/Passes/ReplicateHotDispatch.h ------------------------*- C++ -*-==//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Replicate a small, very hot "dispatch" block (a block ending with an
+// indirect jump through a jump table, i.e. the head of a switch/interpreter
+// dispatch loop) at its hottest unconditional predecessors.
+//
+// Motivation: a block can only fall through from one predecessor.  In a
+// dispatch loop the dispatch block D has hundreds of predecessors (one per
+// case body), therefore every case body except the one laid out right before D
+// has to end with a taken `jmp D`.  Replicating D right after a hot case body
+// turns that taken jump into a fall-through.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef BOLT_PASSES_REPLICATE_HOT_DISPATCH_H
+#define BOLT_PASSES_REPLICATE_HOT_DISPATCH_H
+
+#include "bolt/Passes/BinaryPasses.h"
+
+namespace llvm {
+namespace bolt {
+
+class ReplicateHotDispatch : public BinaryFunctionPass {
+  /// Number of functions whose layout was changed.
+  uint64_t ModifiedFunctions{0};
+  /// Number of replicated basic blocks.
+  uint64_t ReplicatedBlocks{0};
+  /// Number of bytes added by the replication.
+  uint64_t ReplicatedBytes{0};
+  /// Dynamic count of the taken branches removed by the replication.
+  uint64_t RemovedTakenBranches{0};
+
+  /// Return true if \p BB ends with an indirect jump through a jump table
+  /// and does not contain any call (i.e. it can be part of a dispatch chain).
+  bool isDispatchTail(const BinaryBasicBlock &BB) const;
+
+public:
+  explicit ReplicateHotDispatch(const cl::opt<bool> &PrintPass)
+      : BinaryFunctionPass(PrintPass) {}
+
+  const char *getName() const override { return "replicate-hot-dispatch"; }
+
+  bool runOnFunction(BinaryFunction &BF);
+
+  /// Pass entry point.
+  Error runOnFunctions(BinaryContext &BC) override;
+};
+
+} // namespace bolt
+} // namespace llvm
+
+#endif
